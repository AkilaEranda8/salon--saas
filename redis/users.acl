user default off
user salon_cache on sanitize-payload ~t:* resetchannels -@all +ping +info +get +set +setex +del +exists +ttl +mget +mset +incr +decr
user salon_queue on sanitize-payload ~* resetchannels +@all
user salon_session on sanitize-payload ~ai:booking:* resetchannels -@all +ping +get +set +setex +del +exists +ttl
user salon_app on sanitize-payload ~* resetchannels +@all
